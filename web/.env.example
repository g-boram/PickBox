# 이 파일을 복사해서 .env 를 만들고 실제 값을 채운다. (.env 는 git에 올라가지 않는다)

# Neon > Connect > "Connection pooling" 켠 주소 (호스트에 -pooler 가 붙음) — 서버 실행 중 사용
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Neon > Connect > "Connection pooling" 끈 주소 — 마이그레이션 등 Prisma CLI 에서 사용
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# seed 로 만들 관리자 계정
SEED_ADMIN_EMAIL="admin@pickbox.dev"
SEED_ADMIN_PASSWORD="change-me"
